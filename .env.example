# RetroShare environment configuration — copy to .env and adjust.
# NEVER commit a real .env file.

# --- Required in production -------------------------------------------------
# JWT signing secret, minimum 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars

# Bootstrap administrator (seeded on first start).
# ChangeMe!123 is the development seed value — production refuses to boot with it.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@retroshare.local
ADMIN_PASSWORD=ChangeMe!123

# --- Storage ---------------------------------------------------------------
# Default per-user quota and single-file cap, in bytes (defaults: 10 GiB / 2 GiB).
DEFAULT_QUOTA_BYTES=10737418240
MAX_FILE_BYTES=2147483648

# --- Reverse proxy (optional) ----------------------------------------------
# Uncomment when a TLS-terminating proxy fronts the app so rate limiting sees
# real client IPs. List the proxy IPs that may set X-Forwarded-* headers.
#FORWARDED_HEADERS_ENABLED=true
#FORWARDED_HEADERS_KNOWN_PROXIES=127.0.0.1
